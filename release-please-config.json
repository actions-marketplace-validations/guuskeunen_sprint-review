{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@guuskeunen/sprint-review",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-v-in-tag": true,
      "extra-files": [
        { "type": "json", "path": "server.json", "jsonpath": "$.version" },
        { "type": "json", "path": "server.json", "jsonpath": "$.packages[0].version" },
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugin/.claude-plugin/plugin.json", "jsonpath": "$.version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Faster" },
        { "type": "docs", "section": "Docs", "hidden": false },
        { "type": "refactor", "section": "Changed", "hidden": true },
        { "type": "chore", "hidden": true },
        { "type": "ci", "hidden": true },
        { "type": "build", "hidden": true },
        { "type": "test", "hidden": true }
      ]
    }
  }
}
